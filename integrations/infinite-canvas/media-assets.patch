+    const task = { id: "accepted-public-task", provider: "openai" as const, model: cfg.model };
+    const calls: { method: string; url: string }[] = [];
+    let queryFails = true;
+    let downloadFails = true;
+    let status = "completed";
+    axios.defaults.adapter = async request => {
+        calls.push({ method: request.method!, url: request.url! });
+        expect(request.headers.Authorization).toBe("Bearer customer-fixture");
+        if (!request.url!.endsWith("/content") && queryFails) {
+            queryFails = false;
+            throw new Error("temporary query interruption");
+        }
+        if (request.url!.endsWith("/content") && downloadFails) {
+            downloadFails = false;
+            throw new Error("temporary download interruption");
+        }
+        return { config: request, status: 200, statusText: "OK", headers: {}, data: request.url!.endsWith("/content") ? new Blob(["video"], { type: "video/mp4" }) : { status, error: status === "failed" ? { message: "Model rejected the input" } : undefined } };
+    };
+    for (const message of ["temporary query interruption", "temporary download interruption"]) {
+        const error = await waitForVideoGenerationTask(cfg, task).then(() => undefined, error => error);
+        expect(error.message).toContain(message);
+        expect(isVideoTaskFailed(error)).toBe(false);
+    }
