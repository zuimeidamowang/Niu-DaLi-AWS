new file mode 100644
index 0000000..303821f
--- /dev/null
+++ b/web/src/services/api/media-assets-video.ts
@@ -0,0 +1,48 @@
+import axios from "axios";
+import { inferVideoRatio, parseVideoResolution } from "@/lib/media-size";
+import { seedanceDefaultPrompt } from "@/lib/seedance-capabilities";
+import { boolConfig, buildApiUrl, type AiConfig } from "@/stores/use-config-store";
+
+type MediaAsset = { id: string; object: string; status: string; type: "image" | "video" };
+type MediaReference = { asset_id: string; role: "first_frame" | "last_frame" | "reference_image" | "reference_video" };
+const extensions: Record<string, string> = { "image/png": "png", "image/jpeg": "jpg", "image/webp": "webp", "video/mp4": "mp4", "video/webm": "webm", "video/quicktime": "mov" };
+
+export async function createMediaAssetsVideoTask(config: AiConfig, model: string, prompt: string, images: File[], videos: File[], audios: File[], signal?: AbortSignal): Promise<string> {
+    signal?.throwIfAborted();
+    if (audios.length) throw new Error("本站素材接口暂支持图片和视频，请移除参考音频");
+    const frames = config.videoMode === "frames" && images.length > 0;
+    if (frames && (images.length > 2 || videos.length)) throw new Error("首尾帧模式只能使用一张首帧或两张首尾帧图片；参考视频请选择参考模式");
+    if (config.videoMode === "frames" && videos.length) throw new Error("参考视频请选择参考模式");
+    for (const file of [...images, ...videos]) {
+        if (!file.size || !["image/png", "image/jpeg", "image/webp", "video/mp4", "video/webm", "video/quicktime"].includes(file.type)) throw new Error("请选择 PNG、JPEG、WebP 图片或 MP4、WebM、MOV 视频");
+    }
+    const text = prompt.trim() || (images.length + videos.length ? seedanceDefaultPrompt : "");
+    if (!text) throw new Error("请填写提示词或连接参考素材");
+    const duration = Number(config.videoSeconds || "6");
+    if (!Number.isSafeInteger(duration) || duration < 1 || duration > 3600) throw new Error("视频时长必须是 1–3600 秒内的整数，具体范围取决于模型");
+    const ratio = inferVideoRatio(config.size);
+    if (ratio === "auto") throw new Error("请选择明确的视频比例");
+    const media: MediaReference[] = [];
+    // Each upload streams a binary file to our gateway. No upstream upload
+    // ticket, provider URL, or provider credential enters the browser.
+    for (const [files, type] of [[images, "image"], [videos, "video"]] as const) {
+        for (let index = 0; index < files.length; index += 1) {
+            signal?.throwIfAborted();
+            const body = new FormData();
+            const file = files[index];
+            body.append("file", new File([file], `reference.${extensions[file.type]}`, { type: file.type }));
+            const response = await axios.post<MediaAsset>(buildApiUrl(config.baseUrl, "/media/assets"), body, { headers: { Authorization: `Bearer ${config.apiKey}` }, signal });
+            const asset = response.data;
+            if (asset.object !== "media.asset" || asset.status !== "ready" || asset.type !== type || !/^media_[a-zA-Z0-9_-]+$/.test(asset.id)) throw new Error("素材上传未完成，未提交生成任务");
+            media.push({ asset_id: asset.id, role: type === "video" ? "reference_video" : frames ? index === 0 ? "first_frame" : "last_frame" : "reference_image" });
+        }
+    }
+    signal?.throwIfAborted();
+    const resolution = parseVideoResolution(config.vquality);
+    const response = await axios.post<{ id?: string }>(buildApiUrl(config.baseUrl, "/videos"), {
+        model, prompt: text, duration, resolution: resolution.endsWith("k") ? resolution : `${resolution}p`, ratio, ...(media.length ? { media } : {}),
+        ...(model.startsWith("doubao-seedance-") ? { generate_audio: boolConfig(config.videoGenerateAudio, true) } : {}),
+    }, { headers: { Authorization: `Bearer ${config.apiKey}` }, signal });
+    if (typeof response.data.id !== "string" || !response.data.id.trim()) throw new Error("网关未返回任务 ID，请先核对任务记录，不要重复提交");
+    return response.data.id;
+}
