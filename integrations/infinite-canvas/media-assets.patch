diff --git a/web/src/lib/media-assets.ts b/web/src/lib/media-assets.ts
new file mode 100644
index 0000000..abdd3e8
--- /dev/null
+++ b/web/src/lib/media-assets.ts
@@ -0,0 +1,21 @@
+import { isDlnGateway, isDirect88Api, type VideoAdapter } from "./seedance-capabilities";
+
+// Automatic selection is limited to the gateway's published model IDs.
+// Other models opt into the same stable contract in the channel editor.
+const gatewayModels = new Set([
+    "doubao-seedance-2-0", "doubao-seedance-2-0-fast", "doubao-seedance-2-0-mini", "doubao-seedance-2-5",
+    "doubao-seedance-2-0-260128", "doubao-seedance-2-0-fast-260128", "doubao-seedance-2-0-mini-260615", "doubao-seedance-2-5-260628",
+    "sd-2.5-ch4", "SD2.0满血稳定933",
+]);
+
+export function usesMediaAssetsAdapter(config: { baseUrl: string; videoAdapter?: VideoAdapter }, model: string): boolean {
+    if (isDirect88Api(config.baseUrl)) return false;
+    if (config.videoAdapter) return config.videoAdapter === "media_assets";
+    return isDlnGateway(config.baseUrl) && gatewayModels.has(model);
+}
+
+export function getMediaAssetsVideoCapabilities(model: string) {
+    if (!gatewayModels.has(model)) return undefined;
+    const resolutions = model.includes("fast") || model.includes("mini") || model === "sd-2.5-ch4" || model === "SD2.0满血稳定933" ? ["720"] : ["720", "1080"];
+    return { resolutions, ratios: ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16"] };
+}
