+    status = "failed";
+    const terminalError = await waitForVideoGenerationTask(cfg, task).then(() => undefined, error => error);
+    expect(isVideoTaskFailed(terminalError)).toBe(true);
+    expect(calls.every(call => call.method === "get")).toBe(true);
+    expect(calls.every(call => call.url.startsWith("https://www.daliniuai.com/v1/videos/accepted-public-task"))).toBe(true);
+    expect(calls.filter(call => call.url.endsWith("/content"))).toHaveLength(2);
+});
