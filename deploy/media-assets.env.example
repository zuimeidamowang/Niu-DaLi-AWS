# Merge these keys into the app environment after reviewing the running Compose file.
# Disabled by default. This file contains no usable credentials.
MEDIA_ASSET_ENABLED=false
MEDIA_ASSET_S3_BUCKET=CHANGE_ME_PRIVATE_BUCKET
MEDIA_ASSET_S3_REGION=ap-northeast-1
MEDIA_ASSET_PUBLIC_BASE_URL=https://www.daliniuai.com
MEDIA_ASSET_SIGNING_KEY=CHANGE_ME_GENERATE_AT_DEPLOYMENT
MEDIA_ASSET_MAX_IMAGE_BYTES=52428800
MEDIA_ASSET_MAX_VIDEO_BYTES=524288000
MEDIA_ASSET_USER_MAX_BYTES=5368709120
# Leave empty on AWS. An endpoint is only needed for S3-compatible storage/testing.
MEDIA_ASSET_S3_ENDPOINT=
# Prefer the existing EC2/ECS workload role. Do not store AWS keys in channel options.
